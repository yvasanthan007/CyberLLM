from urllib.parse import urlsplit
import ipaddress
import re

import numpy as np
import pandas as pd
from sklearn.base import BaseEstimator, TransformerMixin


def parse_url(value):
    value = str(value).strip()

    try:
        parsed = urlsplit(value)
        hostname = (parsed.hostname or "").lower().rstrip(".")
        scheme = parsed.scheme.lower()

        if scheme not in {"http", "https"} or not hostname:
            return None

        try:
            ipaddress.ip_address(hostname)
            is_ip = 1
        except ValueError:
            is_ip = 0

        return {
            "url": value,
            "hostname": hostname,
            "scheme": scheme,
            "path": parsed.path or "",
            "query": parsed.query or "",
            "fragment": parsed.fragment or "",
            "is_ip": is_ip,
        }
    except (ValueError, TypeError):
        return None


def hostname_features(url):
    parsed = parse_url(url)

    if parsed is None:
        return {
            "invalid_url": 1,
            "hostname_length": 0,
            "hostname_dot_count": 0,
            "subdomain_count": 0,
            "is_ip": 0,
        }

    host = parsed["hostname"]
    labels = host.split(".")
    path = parsed["path"]
    query = parsed["query"]
    url_lower = parsed["url"].lower()

    try:
        ipaddress.ip_address(host)
        is_ip = 1
    except ValueError:
        is_ip = 0

    return {
        "invalid_url": 0,
        "hostname_length": len(host),
        "hostname_dot_count": host.count("."),
        "subdomain_count": max(0, len(labels) - 2),
        "is_ip": is_ip,
        "uses_https": int(parsed["scheme"] == "https"),
        "uses_http": int(parsed["scheme"] == "http"),
        "path_length": len(path),
        "query_length": len(query),
        "url_length": len(parsed["url"]),
        "hostname_hyphen_count": host.count("-"),
        "hostname_digit_count": sum(c.isdigit() for c in host),
        "hostname_underscore_count": host.count("_"),
        "hostname_has_punycode": int("xn--" in host),
        "hostname_has_brand_word": int(
            any(word in host for word in (
                "paypal", "microsoft", "google", "apple",
                "amazon", "facebook", "youtube", "netflix",
            ))
        ),
        "host_has_login_word": int(
            any(word in host for word in ("login", "signin", "verify", "secure"))
        ),
        "url_has_at": int("@" in parsed["url"]),
        "url_has_encoded_chars": int("%" in parsed["url"]),
        "url_has_double_slash_path": int("//" in path),
        "url_has_password_word": int(
            any(word in url_lower for word in ("password", "passwd"))
        ),
        "url_has_redirect_word": int(
            any(word in url_lower for word in ("redirect", "return=", "continue="))
        ),
        "url_has_ip_text": int(
            bool(re.search(r"(?:\d{1,3}\.){3}\d{1,3}", host))
        ),
        "tld_length": len(labels[-1]) if labels else 0,
    }


class URLFeatureExtractor(BaseEstimator, TransformerMixin):
    """Convert URLs to the numeric features used by the candidate model."""

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        # ColumnTransformer passes a one-column DataFrame for ["URL"].
        # Iterate over its URL values, not its column names.
        if isinstance(X, pd.DataFrame):
            if "URL" in X.columns:
                values = X["URL"].tolist()
            elif X.shape[1] == 1:
                values = X.iloc[:, 0].tolist()
            else:
                raise ValueError(
                    "URLFeatureExtractor expects a URL column "
                    "or a single-column DataFrame."
                )
        elif isinstance(X, pd.Series):
            values = X.tolist()
        else:
            values = np.asarray(X, dtype=object).reshape(-1).tolist()

        records = [hostname_features(value) for value in values]
        return pd.DataFrame(records).fillna(0).to_numpy(dtype=np.float64)
