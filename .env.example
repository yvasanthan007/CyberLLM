# CyberLLM environment configuration example.
# Copy to .env and fill in real values. NEVER commit a real .env file.

# API key required by clients calling /chat, /phishing/predict, etc.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CYBERLLM_API_KEY=replace-with-a-long-random-string

# Base URL Zyra (or other clients) uses to reach CyberLLM.
# Keep as 127.0.0.1 unless running CyberLLM on another machine.
CYBERLLM_BASE_URL=http://127.0.0.1:8765

# Optional: NVD API key for CVE dataset refreshes (referenced in configs/config.py)
NVD_API_KEY=

# Local LLM (Phase 2)
# HF model id or local path. Default is Qwen/Qwen2.5-0.5B-Instruct (Apache-2.0).
CYBERLLM_LLM_ENABLED=1
CYBERLLM_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
CYBERLLM_LLM_MAX_NEW_TOKENS=256
CYBERLLM_LLM_TIMEOUT_S=60
CYBERLLM_LLM_MAX_CONTEXT_CHARS=3500

# Where the HF hub cache lives (models download here once, resumably)
HF_HOME=D:\HuggingFace
