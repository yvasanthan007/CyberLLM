# CyberLLM environment configuration
#
# Copy this file to `.env` and edit. `.env` is git-ignored and must never be
# committed. No value below is a real credential - they are placeholders.
#
# Every setting is optional: with none of them set, CyberLLM starts in a
# clearly labelled demo mode and the CLI reports exactly what to configure.

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# auto | transformers | ollama | openai | demo
# "auto" prefers a local model (Ollama, then transformers) and falls back to
# the clearly-labelled demo template.
CYBERLLM_PROVIDER=auto

# Local transformers model. A small model keeps the demo path light; for real
# answers use an instruct-tuned model, e.g. Qwen/Qwen2.5-0.5B-Instruct.
CYBERLLM_MODEL=sshleifer/tiny-gpt2

# Ollama daemon (CYBERLLM_PROVIDER=ollama). Verify with `ollama list` first -
# the backend checks the model is actually pulled, not just that the daemon
# is running.
CYBERLLM_MODEL_OLLAMA=qwen2.5:3b
CYBERLLM_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI (CYBERLLM_PROVIDER=openai). Put the key in your environment or a
# secrets manager - never in this file, never in git.
# OPENAI_API_KEY=sk-...

# HF_TOKEN only needed for gated/private Hugging Face repositories.
# HF_TOKEN=hf_...

# Allow startup with no reachable model. Set false to fail fast instead.
CYBERLLM_DEMO_MODE=true

# Generation controls
CYBERLLM_MAX_NEW_TOKENS=512
CYBERLLM_TOP_K=5

# ---------------------------------------------------------------------------
# NVD
# ---------------------------------------------------------------------------
# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Raises the rate limit from ~5 requests/30s to ~50 requests/30s.
# NVD_API_KEY=

# Cap on records pulled in one keyless run.
CYBERLLM_NVD_MAX_RECORDS=400

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# hashing = dependency-free, lexical, instant. Sentence-transformers gives
# true semantic retrieval but needs the package and a model download.
CYBERLLM_EMBEDDING_BACKEND=hashing
CYBERLLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Service / security
# ---------------------------------------------------------------------------
# REQUIRED before binding to anything other than 127.0.0.1. The service has
# no TLS; put it behind a TLS-terminating proxy if it must be reachable.
# CYBERLLM_API_KEY=

# Request and upload ceilings
CYBERLLM_MAX_UPLOAD_BYTES=5242880
CYBERLLM_MAX_REQUEST_BYTES=2097152

# Set to disable chat/analysis history retention entirely.
CYBERLLM_NO_HISTORY=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
CYBERLLM_ENV=development
CYBERLLM_LOG_LEVEL=INFO
CYBERLLM_SEED=42
